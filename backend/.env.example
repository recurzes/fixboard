# Required. Must use the psycopg driver and Neon's direct host (no -pooler), which Alembic needs:
# postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Required. The base URL shown under Auth in the Neon console. Each Neon branch has its own.
NEON_AUTH_URL=

# Only needed by python -m app.staff.seed. Admin access to the Neon project, so never commit the key.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Required. An S3-compatible bucket for tenant photos. It must be private, and the secret key
# stays on the server.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Optional. Use the value your storage provider gives.
STORAGE_REGION=auto

# Optional. Sentry stays off when empty.
SENTRY_DSN=

# Optional. false closes the public request form, which then tells tenants to call.
PUBLIC_FORM_ENABLED=true

# Optional. Limits on the public request form. Anyone can pick any unit, so a low unit limit
# lets someone block a real tenant for up to an hour.
RATE_LIMIT_IP=10/minute
RATE_LIMIT_UNIT_PER_HOUR=10
