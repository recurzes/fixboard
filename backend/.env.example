# Required. Must use the psycopg driver and Neon's direct host (no -pooler), which Alembic needs:
# postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Required. The base URL shown under Auth in the Neon console. Each Neon branch has its own.
NEON_AUTH_URL=

# Only needed by python -m app.staff.seed. Admin access to the Neon project, so never commit the key.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=

# Optional. Sentry stays off when empty.
SENTRY_DSN=
