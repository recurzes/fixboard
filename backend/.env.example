# Required. Must use the psycopg driver: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# Required. The Supabase project URL: https://<project-ref>.supabase.co
SUPABASE_URL=

# Only needed by python -m app.staff.seed. Full admin access to Supabase, so never commit it.
SUPABASE_SERVICE_KEY=

# Optional. Sentry stays off when empty.
SENTRY_DSN=
