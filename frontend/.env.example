# Everything named VITE_ ships to the browser, so never put a server secret here.
# Values are baked in at build time, so changing one needs a rebuild.

# Backend base URL.
VITE_API_URL=http://localhost:8000
# Neon Auth base URL, the same value as the backend's NEON_AUTH_URL.
VITE_NEON_AUTH_URL=
# Optional. Leave empty to turn Sentry off.
VITE_SENTRY_DSN=
